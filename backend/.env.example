# WorkForce Backend Environment Configuration

# Server Port and CORS
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Google GenAI - Gemma 4
# Get your API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it

# Firebase Admin Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id

# Option A: Service account file path (relative to backend/ or absolute)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option B: Direct Service Account credentials (useful for hosting or CI/CD)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...-----END PRIVATE KEY-----\n"

# Optional: Set to true if testing in development without credentials (runs with mocked Firestore for tests)
# DEV_OFFLINE_MODE=false
